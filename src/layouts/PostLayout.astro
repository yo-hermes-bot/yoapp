---
import Layout from "./Layout.astro";
import "katex/dist/katex.min.css";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  structuredData?: object[];
}
---

<Layout {...Astro.props}>
  <main id="main-content" tabindex="-1" class="container-max px-4 py-12">
    <!-- Reading measure: --container-prose is 57ch, which lands at roughly 66-75
         characters of Merriweather depending on the weight rendered (see the
         note on the token in global.css), so long-form MDX stops around 580px
         instead of running the full 1024px grid. Left-aligned rather than
         centred, so the title, the meta line and the first paragraph all start
         on the page's left edge — the same edge as the navbar wordmark and the
         /blog index titles. Header and body share the one column. -->
    <div class="container-prose">
      <slot />
    </div>
  </main>
</Layout>
